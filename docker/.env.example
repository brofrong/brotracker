# Copy to docker/.env and override what you need.
# docker compose -f docker/docker-compose.yml up -d

APP_PORT=8080

CORS_ORIGIN=http://localhost:8080
BETTER_AUTH_URL=http://localhost:8080

# Optional: Authentik OIDC. Omit (or leave empty) for local email/password auth.
# First visitor registers; further sign-ups are closed.
# AUTHENTIK_CLIENT_ID=
# AUTHENTIK_CLIENT_SECRET=
# AUTHENTIK_DISCOVERY_URL=http://host.docker.internal:9080/application/o/brotracker/.well-known/openid-configuration

# POSTGRES_USER=brotracker
# POSTGRES_PASSWORD=brotracker
# POSTGRES_DB=brotracker
