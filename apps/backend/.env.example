# Postgres (matches docker/docker-compose.dev.yml)
DATABASE_URL=postgresql://brotracker:brotracker@localhost:5432/brotracker

# API
PORT=3101
CORS_ORIGIN=http://localhost:3100

# MinIO / S3 (covers; public URLs are proxied via GET /media/...)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=brotracker

# Cloudflare solver (Byparr / FlareSolverr-compatible)
BYPARR_URL=http://localhost:8191/v1

# Better Auth + Authentik OIDC
# BETTER_AUTH_SECRET is auto-generated and stored in app_settings on first boot.
BETTER_AUTH_URL=http://localhost:3101
AUTHENTIK_CLIENT_ID=brotracker-local-client-id
AUTHENTIK_CLIENT_SECRET=brotracker-local-client-secret
AUTHENTIK_DISCOVERY_URL=http://localhost:9080/application/o/brotracker/.well-known/openid-configuration

# Optional: directory with frontend SPA assets (set automatically in Docker)
# STATIC_DIR=./public
