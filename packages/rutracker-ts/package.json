{
	"name": "rutracker-ts",
	"version": "0.0.1",
	"description": "Rutracker API for NodeJS with TypeScript",
	"keywords": [
		"rutracker",
		"api",
		"typescript"
	],
	"author": "Brofrong",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/brofrong/rutracker-ts.git"
	},
	"homepage": "https://github.com/brofrong/rutracker-ts#readme",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"type": "module",
	"exports": {
		"./*": "./src/*.ts"
	},
	"scripts": {
		"start": "bun run src/index.ts",
		"build": "tsdown",
		"test": "bun test",
		"dev": "bun run --env-file=.env.test.local test/test.ts",
		"lint": "biome check ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.5",
		"@types/bun": "latest",
		"tsdown": "^0.15.6",
		"typescript": "^5"
	},
	"dependencies": {
		"axios": "^1.12.2",
		"https-proxy-agent": "^7.0.6",
		"iconv-lite": "^0.7.1",
		"neverthrow": "^8.2.0",
		"node-html-parser": "^7.0.1",
		"zod": "^4.1.12"
	}
}
