{
	"name": "brotracker",
	"version": "0.14.1",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"test": "bun run --cwd apps/backend test && bun run --cwd packages/rutracker-ts test",
		"release": "bun scripts/release.ts"
	},
	"devDependencies": {
		"turbo": "^2.11.5",
		"typescript": "^7.0.2"
	},
	"engines": {
		"bun": ">=1.4.0"
	},
	"packageManager": "bun@1.4.4",
	"overrides": {
		"bun-types": "1.4.0"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
