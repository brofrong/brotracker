{
  "name": "brotracker",
  "version": "0.11.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "bun run --cwd apps/backend test && bun run --cwd packages/rutracker-ts test",
    "release": "bun scripts/release.ts"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "turbo": "^2.11.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "overrides": {
    "bun-types": "1.4.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
